#!/bin/bash

# One-time setup on Omarchy: keep the sidebar's colours in sync with the
# Omarchy theme. The extension itself is loaded with "Load unpacked" (see
# README); --load-extension in chromium-flags.conf is ignored when Enhanced
# Safe Browsing is on.

set -euo pipefail

ext="$(cd "$(dirname "$0")/.." && pwd)"
hook="$HOME/.config/omarchy/hooks/theme-set.d/arc-sidebar"

mkdir -p "$(dirname "$hook")"
install -m 755 "$ext/tools/omarchy-theme-hook" "$hook"
ARC_SIDEBAR_DIR="$ext" "$hook"
echo "Installed theme hook at $hook"

echo
echo "Now load the extension: chrome://extensions -> Developer mode -> Load unpacked -> $ext"

{
  "manifest_version": 3,
  "name": "Arc Sidebar",
  "version": "0.1.0",
  "description": "Arc-style sidebar: favourites, spaces of pinned bookmarks, and today's tabs in one place.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle sidebar"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "bookmarks",
    "favicon",
    "history",
    "search",
    "sidePanel",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Toggle the sidebar"
    },
    "next-space": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "Switch to the next space"
    },
    "previous-space": {
      "suggested_key": {
        "default": "Alt+Shift+Left"
      },
      "description": "Switch to the previous space"
    },
    "new-tab-in-space": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "New tab in the current space"
    },
    "pin-current-tab": {
      "description": "Pin the current tab to the space (or unpin it)"
    },
    "archive-current-tab": {
      "description": "Archive the current tab"
    },
    "focus-search": {
      "description": "Open the sidebar and search tabs, pinned tabs and history"
    }
  }
}
